# =================================================================
# TalentFlow 360 - Production Environment Configuration Template
# =================================================================
# Copy this file to .env on your deployment server:
#   cp .env.example .env
# Replace placeholder values with strong, secure credentials.
# =================================================================

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -------------------------------------------------------------
# Name of the MySQL database
DB_NAME=talentflow_db

# Strong root password for MySQL (e.g. 16+ alphanumeric characters)
DB_PASSWORD=ChangeThisToStrongPassword123!

# MongoDB database name for resume documents & unstructured ATS data
MONGO_DB_NAME=talentflow_resumes

# -------------------------------------------------------------
# 2. SECURITY & JWT CONFIGURATION
# -------------------------------------------------------------
# 256-bit Hex or Base64 secret key for signing JWT tokens (HMAC-SHA256)
# Generate one on Linux via: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token Expiry (in milliseconds): 86400000 ms = 24 hours
JWT_EXPIRATION_MS=86400000

# Refresh Token Expiry (in milliseconds): 604800000 ms = 7 days
JWT_REFRESH_EXPIRATION_MS=604800000

# High-entropy API key for automated maintenance and admin audit scripts
ADMIN_API_KEY=tf360_prod_admin_secret_key_9980

# -------------------------------------------------------------
# 3. EMAIL & NOTIFICATION DISPATCH (Gmail SMTP)
# -------------------------------------------------------------
# Required for sending 1-click candidate offer letters and OTP codes
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-recruiting-email@gmail.com
# Google App Password (not your personal account password)
MAIL_PASSWORD=your-16-char-app-password

# -------------------------------------------------------------
# 4. NETWORKING & PORT BINDING
# -------------------------------------------------------------
# Public HTTP port bound to the host (Default: 80)
PORT=80
