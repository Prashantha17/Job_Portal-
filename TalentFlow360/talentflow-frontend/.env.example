# TalentFlow 360 Frontend Environment Configuration
# API Backend URL (Spring Boot 3.4.2)
VITE_API_URL=http://localhost:8080

# Firebase Configuration for Real Google Sign-In
# You can get these keys from your Firebase Console:
# 1. Visit https://console.firebase.google.com
# 2. Select / Create project -> Authentication -> Sign-in method -> Enable Google
# 3. Project Settings -> General -> Your apps -> Web app (</>) -> Copy firebaseConfig
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=

